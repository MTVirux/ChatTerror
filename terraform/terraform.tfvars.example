# Copy to terraform.tfvars (gitignored) and edit.
#
# Tokens do NOT live in this file. Export them from a gitignored .envrc:
#   TF_VAR_hcloud_token - project the server goes in
#   TF_VAR_dns_token    - project holding the DNS zone, if different
#   TF_VAR_github_token - read-only PAT, if the repo is private

# --- required ---

domain     = "mtvirux.app"
acme_email = "you@example.com"

# Inline the public key contents - tfvars only accepts literals, not file().
ssh_public_key    = "ssh-ed25519 AAAAC3Nza... user@host"
ssh_allowed_cidrs = ["1.2.3.4/32"]

# --- optional: variables.tf holds the real defaults ---

# ssh_private_key_path = "~/.ssh/id_ed25519"  # used to copy the GitHub token to the VM
# subdomain        = "chatterror"  # "@" serves the relay on the apex
# location         = "fsn1"
# server_type      = "cx23"
# data_volume_size = 10
# image            = "ubuntu-24.04"
# repo_url         = "https://github.com/MTVirux/ChatTerror.git"
# repo_ref         = "master"
