# Copy to terraform.tfvars (gitignored) and edit.
#
# The API token does NOT live in this file. Export it as TF_VAR_hcloud_token,
# e.g. from a gitignored .envrc loaded by direnv.

# --- required ---

domain     = "example.com"
acme_email = "you@example.com"

# Inline the public key contents - tfvars only accepts literals, not file().
ssh_public_key    = "ssh-ed25519 AAAAC3Nza... user@host"
ssh_allowed_cidrs = ["1.2.3.4/32"]

# --- optional: variables.tf holds the real defaults ---

# subdomain        = "chat"   # "@" serves the relay on the apex
# location         = "fsn1"
# server_type      = "cx23"
# data_volume_size = 10
# image            = "ubuntu-24.04"
# repo_url         = "https://github.com/MTVirux/ChatTerror.git"
# repo_ref         = "master"
